---
import Base from '../layouts/Base.astro';

const allPosts = import.meta.glob('./blog/*.md', { eager: true });
const posts = Object.values(allPosts) as any[];
const sorted = posts
  .filter(p => !p.frontmatter.draft)
  .sort((a, b) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime());
---
<Base front>
  {sorted.length === 0 ? (
    <p class="empty">No posts yet. Check back soon.</p>
  ) : (
    <ul class="post-list">
      {sorted.map(post => {
        const formatted = new Date(post.frontmatter.date + 'T12:00:00').toLocaleDateString('en-US', {
          year: 'numeric', month: 'short', day: 'numeric'
        });
        return (
          <li>
            <a href={post.url}>{post.frontmatter.title}</a>
            <time datetime={post.frontmatter.date}>{formatted}</time>
          </li>
        );
      })}
    </ul>
  )}
  <p class="human-note">All writing is my own — no AI-generated content.</p>
</Base>
